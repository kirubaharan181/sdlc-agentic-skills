  "decisions": [
    {
      "after": 70,
      "question": "Does the change break existing consumers?",
      "branches": {
        "yes": "workflow:api-version-upgrade",
        "no": 37
      }
    }
  ],
  "failure_paths": [
    {
      "at": 85,
      "condition": "Unintended behaviour change detected",
      "action": "Revert the unintended part or get product-owner approval to accept it",
      "goto": 55
    }
  ],
  "outputs": [
    "merged_enhancement",
    "regression_report",
    "release_record",
    "feedback_summary"
  ],
  "exit_criteria": [
    "Intended behaviour changed and nothing else",
    "Regression suite passes",
    "Customer feedback loop opened"
  ],
  "communication_plan": "Notify users of changed behaviour in release notes.",
  "handoff_workflows": [
