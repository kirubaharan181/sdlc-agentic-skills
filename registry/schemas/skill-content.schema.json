{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-content.schema.json",
  "title": "Authored skill documentation",
  "type": "object",
  "additionalProperties": false,
  "required": ["skill_id", "version", "author", "description", "tags", "keywords", "purpose", "when_to_use", "when_not_to_use",
               "prerequisites", "inputs", "outputs", "decision_rules", "quality_gates", "examples", "limitations",
               "troubleshooting", "handoffs", "owns"],
  "properties": {
    "skill_id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "author": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 50, "maxLength": 150},
    "tags": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}},
    "keywords": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
    "purpose": {"type": "string", "minLength": 80},
    "when_to_use": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 10}},
    "when_not_to_use": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 10}},
    "prerequisites": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 10}},
    "inputs": {"type": "object", "additionalProperties": false, "required": ["required"],
               "properties": {"required": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "optional": {"type": "array", "items": {"type": "string"}}}},
    "outputs": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "decision_rules": {"type": "array", "minItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["situation", "action"],
                       "properties": {"situation": {"type": "string", "minLength": 8}, "action": {"type": "string", "minLength": 8}}}},
    "quality_gates": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 8}},
    "examples": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false,
                 "required": ["title", "request", "context", "behavior", "output", "acceptance"],
                 "properties": {"title": {"type": "string"}, "request": {"type": "string"}, "context": {"type": "string"}, "behavior": {"type": "string"}, "output": {"type": "string"}, "acceptance": {"type": "string"}}}},
    "limitations": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 10}},
    "troubleshooting": {"type": "array", "minItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["error", "cause", "resolution"],
                        "properties": {"error": {"type": "string"}, "cause": {"type": "string"}, "resolution": {"type": "string"}}}},
    "handoffs": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["skill", "artifact"],
                 "properties": {"skill": {"type": "string"}, "artifact": {"type": "string", "minLength": 8}, "feedback": {"type": "boolean"}}}},
    "owns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}}
  }
}
