{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent.schema.json",
  "title": "Role/agent record (resolved)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent_id",
    "name",
    "purpose",
    "scope",
    "responsibilities",
    "non_responsibilities",
    "required_skills",
    "inputs",
    "outputs",
    "tools",
    "permissions",
    "dependencies",
    "handoff_rules",
    "escalation_conditions",
    "approval_requirements",
    "definition_of_done"
  ],
  "properties": {
    "agent_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "purpose": {
      "type": "string",
      "minLength": 10
    },
    "scope": {
      "type": "string",
      "minLength": 3
    },
    "responsibilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "non_responsibilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "required_skills": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "minItems": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "permissions": {
      "type": "string",
      "minLength": 10
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "handoff_rules": {
      "type": "string",
      "minLength": 10
    },
    "escalation_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "approval_requirements": {
      "type": "string",
      "minLength": 10
    },
    "definition_of_done": {
      "type": "string",
      "minLength": 10
    }
  }
}
