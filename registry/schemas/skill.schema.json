{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill.schema.json",
  "title": "Skill record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skill_id",
    "path",
    "stage_ids"
  ],
  "properties": {
    "skill_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "path": {
      "type": "string",
      "pattern": "^skills/.+/SKILL\\.md$"
    },
    "stage_ids": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 190
      }
    }
  }
}
