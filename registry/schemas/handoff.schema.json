{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "handoff.schema.json",
  "title": "Handoff record between two skills or roles",
  "type": "object",
  "additionalProperties": false,
  "required": ["handoff_id", "from_skill", "to_skill", "stage_ids", "artifacts", "validation", "gate_status", "risks", "limitations", "sender", "receiver", "next_action", "approval", "acceptance"],
  "properties": {
    "example": {"type": "boolean"},
    "handoff_id": {"type": "string", "pattern": "^HO-[0-9]{4}-[0-9]{3,}$"},
    "from_skill": {"type": "string"},
    "to_skill": {"type": "string"},
    "stage_ids": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 190}},
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "revision"],
                  "properties": {"path": {"type": "string", "minLength": 1}, "revision": {"type": "string", "minLength": 1}}}},
    "validation": {"type": "object", "additionalProperties": false, "required": ["method", "result"],
                   "properties": {"method": {"type": "string", "minLength": 1}, "result": {"type": "string", "minLength": 1}}},
    "gate_status": {"enum": ["PASS", "FAIL", "BLOCKED", "INCONCLUSIVE", "NEEDS_HUMAN_APPROVAL", "WAIVED", "ILLUSTRATIVE_ONLY"]},
    "risks": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "sender": {"type": "string", "minLength": 1},
    "receiver": {"type": "string", "minLength": 1},
    "next_action": {"type": "string", "minLength": 1},
    "approval": {"type": "object", "additionalProperties": false, "required": ["required", "approver"],
                 "properties": {"required": {"type": "boolean"}, "approver": {"type": ["string", "null"]}, "risk_tier": {"enum": ["R0", "R1", "R2", "R3", "R4", null]}}},
    "acceptance": {"type": "object", "additionalProperties": false, "required": ["accepted_by", "accepted_at"],
                   "properties": {"accepted_by": {"type": ["string", "null"]}, "accepted_at": {"type": ["string", "null"]}}}
  }
}
