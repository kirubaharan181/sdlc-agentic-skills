{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workflow.schema.json",
  "title": "Workflow record (resolved from registry/workflows/<id>.json)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "workflow_id",
    "name",
    "purpose",
    "trigger",
    "entry_criteria",
    "required_inputs",
    "steps",
    "decisions",
    "failure_paths",
    "outputs",
    "exit_criteria",
    "communication_plan",
    "handoff_workflows",
    "stages",
    "responsible_agents",
    "required_skills",
    "approval_points",
    "parallel_groups"
  ],
  "properties": {
    "workflow_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 3
    },
    "purpose": {
      "type": "string",
      "minLength": 15
    },
    "trigger": {
      "type": "string",
      "minLength": 15
    },
    "entry_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "required_inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "exit_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "communication_plan": {
      "type": "string",
      "minLength": 10
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "owner",
          "needs"
        ],
        "properties": {
          "stage": {
            "type": "integer",
            "minimum": 1,
            "maximum": 190
          },
          "owner": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "needs": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "optional": {
            "type": "boolean"
          },
          "note": {
            "type": "string"
          },
          "level": {
            "type": "integer"
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "after",
          "question",
          "branches"
        ],
        "properties": {
          "after": {
            "type": "integer"
          },
          "question": {
            "type": "string",
            "minLength": 8
          },
          "branches": {
            "type": "object",
            "minProperties": 2,
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 190
                },
                {
                  "type": "string",
                  "pattern": "^(end|abort|workflow:[a-z0-9-]+)$"
                }
              ]
            }
          }
        }
      }
    },
    "failure_paths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "at",
          "condition",
          "action",
          "goto"
        ],
        "properties": {
          "at": {
            "type": "integer"
          },
          "condition": {
            "type": "string",
            "minLength": 8
          },
          "action": {
            "type": "string",
            "minLength": 8
          },
          "goto": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 190
              },
              {
                "type": "string",
                "pattern": "^(end|abort|workflow:[a-z0-9-]+)$"
              }
            ]
          }
        }
      }
    },
    "handoff_workflows": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "responsible_agents": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "required_skills": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "excluded_roles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Roles that must not own any step; enforced by validate.py."
    }
  }
}
