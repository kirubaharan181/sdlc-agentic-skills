{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage.schema.json",
  "title": "SDLC stage record (resolved)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stage_id",
    "stage_name",
    "category_id",
    "category_name",
    "primary_role",
    "supporting_roles",
    "skills",
    "agents",
    "workflow_ids",
    "inputs",
    "outputs",
    "quality_gate",
    "approval_required",
    "handoff_requirements",
    "validation_method",
    "purpose",
    "execution_instructions",
    "deliverable_artifacts",
    "quality_criteria",
    "dependencies"
  ],
  "properties": {
    "stage_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 190
    },
    "stage_name": {
      "type": "string",
      "minLength": 2
    },
    "category_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 15
    },
    "category_name": {
      "type": "string",
      "minLength": 2
    },
    "primary_role": {
      "type": "string",
      "minLength": 2
    },
    "supporting_roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "minItems": 1
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "minItems": 1
    },
    "workflow_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "minItems": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "quality_gate": {
      "type": "string",
      "pattern": "^[0-9]{2}-[0-9]{3}$"
    },
    "approval_required": {
      "type": "boolean"
    },
    "approval_rationale": {
      "type": "string",
      "minLength": 10,
      "description": "Required when approval_required is true (enforced by validate.py)."
    },
    "status": {
      "enum": [
        "complete",
        "stub"
      ],
      "description": "complete = stage-specific content written; stub = generated template only."
    },
    "handoff_requirements": {
      "type": "string",
      "minLength": 10
    },
    "validation_method": {
      "type": "string",
      "minLength": 10
    },
    "purpose": {
      "type": "string",
      "minLength": 10
    },
    "execution_instructions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5
      },
      "minItems": 3
    },
    "deliverable_artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "quality_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  }
}
